rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /visitantes/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.tipo == "registrado"
                    && request.resource.data.nombre is string
                    && request.resource.data.escuela is string;

      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.tipo == "registrado"
                    && request.resource.data.nombre is string
                    && request.resource.data.escuela is string;
      allow delete: if isAdmin();
    }

    match /resultados/{resultadoId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && exists(/databases/$(database)/documents/visitantes/$(request.auth.uid));

      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
